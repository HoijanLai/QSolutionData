{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qsolutiondata:schema:qubo-result.v1",
  "title": "QUBO Solver Result v1",
  "type": "object",
  "required": ["schema", "problem_id", "solver", "status", "best_sample", "best_energy", "runtime_seconds"],
  "properties": {
    "schema": {"const": "qubo-result.v1"},
    "problem_id": {"type": "string", "minLength": 1},
    "solver": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"type": "string"}
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["optimal", "feasible", "infeasible", "timeout", "error", "unknown"]
    },
    "best_sample": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"enum": [0, 1]}}
      ]
    },
    "best_energy": {
      "type": ["number", "null"]
    },
    "runtime_seconds": {"type": "number", "minimum": 0},
    "termination_reason": {"type": "string"},
    "metrics": {"type": "object"},
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "time_seconds", "energy"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "time_seconds": {"type": "number", "minimum": 0},
          "energy": {"type": "number"},
          "sample": {
            "type": "array",
            "items": {"enum": [0, 1]}
          },
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
