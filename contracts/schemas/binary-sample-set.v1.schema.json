{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qsolutiondata:schema:binary-sample-set.v1",
  "title": "Aggregated Binary Sample Set v1",
  "type": "object",
  "required": [
    "schema",
    "problem_id",
    "sample_representation",
    "variable_count",
    "distribution_kind",
    "shots",
    "records",
    "sampler",
    "seed",
    "runtime_seconds"
  ],
  "properties": {
    "schema": {"const": "binary-sample-set.v1"},
    "problem_id": {"type": "string", "minLength": 1},
    "sample_representation": {"const": "binary-vector.v1"},
    "variable_count": {"type": "integer", "minimum": 0},
    "distribution_kind": {
      "enum": ["empirical", "exact", "deterministic"]
    },
    "shots": {
      "type": ["integer", "null"]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "sampler": {"$ref": "#/$defs/sampler"},
    "seed": {"type": ["integer", "null"]},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "distribution_kind": {"const": "deterministic"}
        },
        "required": ["distribution_kind"]
      },
      "then": {
        "properties": {
          "shots": {"type": "null"},
          "records": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/record"},
                {
                  "properties": {
                    "occurrences": {"const": 1}
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "shots": {"type": "integer", "minimum": 1}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": ["sample", "occurrences"],
      "properties": {
        "sample": {
          "type": "array",
          "items": {"enum": [0, 1]}
        },
        "occurrences": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
