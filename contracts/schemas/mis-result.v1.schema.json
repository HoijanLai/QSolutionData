{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qsolutiondata:schema:mis-result.v1",
  "title": "Maximum Independent Set Solver Result v1",
  "type": "object",
  "required": [
    "schema",
    "problem_id",
    "solver",
    "status",
    "selected_vertices",
    "objective_value",
    "cardinality",
    "total_weight",
    "feasible",
    "runtime_seconds"
  ],
  "properties": {
    "schema": {"const": "mis-result.v1"},
    "problem_id": {"type": "string", "minLength": 1},
    "solver": {"$ref": "#/$defs/solver"},
    "status": {
      "enum": [
        "optimal",
        "feasible",
        "infeasible",
        "timeout",
        "error",
        "unknown"
      ]
    },
    "selected_vertices": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        }
      ]
    },
    "objective_value": {"type": ["number", "null"]},
    "cardinality": {"type": ["integer", "null"], "minimum": 0},
    "total_weight": {"type": ["number", "null"]},
    "feasible": {"type": ["boolean", "null"]},
    "bounds": {"$ref": "#/$defs/bounds"},
    "proof": {"$ref": "#/$defs/proof"},
    "runtime_seconds": {"type": "number", "minimum": 0},
    "termination_reason": {"type": "string"},
    "metrics": {"type": "object"},
    "trace": {
      "type": "array",
      "items": {"$ref": "#/$defs/traceEntry"}
    },
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["optimal", "feasible"]}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_vertices": {"type": "array"},
          "objective_value": {"type": "number"},
          "cardinality": {"type": "integer"},
          "total_weight": {"type": "number"},
          "feasible": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "infeasible"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "selected_vertices": {"type": "null"},
          "objective_value": {"type": "null"},
          "cardinality": {"type": "null"},
          "total_weight": {"type": "null"},
          "feasible": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"selected_vertices": {"type": "null"}},
        "required": ["selected_vertices"]
      },
      "then": {
        "properties": {
          "objective_value": {"type": "null"},
          "cardinality": {"type": "null"},
          "total_weight": {"type": "null"},
          "feasible": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "objective_value": {"type": "number"},
          "cardinality": {"type": "integer"},
          "total_weight": {"type": "number"},
          "feasible": {"type": "boolean"}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "solver": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"type": "string"}
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "incumbent_lower_bound": {"type": "number"},
        "optimum_upper_bound": {"type": "number"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": [
        "claim",
        "kind",
        "producer",
        "independently_verified"
      ],
      "properties": {
        "claim": {
          "enum": ["optimality", "infeasibility", "bound"]
        },
        "kind": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "independently_verified": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "traceEntry": {
      "type": "object",
      "required": ["step", "time_seconds"],
      "properties": {
        "step": {"type": "integer", "minimum": 0},
        "time_seconds": {"type": "number", "minimum": 0},
        "selected_vertices": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "objective_value": {"type": "number"},
        "cardinality": {"type": "integer", "minimum": 0},
        "total_weight": {"type": "number"},
        "feasible": {"type": "boolean"},
        "metadata": {"type": "object"}
      },
      "dependentRequired": {
        "selected_vertices": [
          "objective_value",
          "cardinality",
          "total_weight",
          "feasible"
        ],
        "objective_value": [
          "selected_vertices",
          "cardinality",
          "total_weight",
          "feasible"
        ],
        "cardinality": [
          "selected_vertices",
          "objective_value",
          "total_weight",
          "feasible"
        ],
        "total_weight": [
          "selected_vertices",
          "objective_value",
          "cardinality",
          "feasible"
        ],
        "feasible": [
          "selected_vertices",
          "objective_value",
          "cardinality",
          "total_weight"
        ]
      },
      "additionalProperties": false
    }
  }
}
