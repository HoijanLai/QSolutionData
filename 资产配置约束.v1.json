  "constraints": [
    {
      "id": "total_weight",
      "kind": "equality",
      "expression": "sum(weight_i) = 1.0",
      "value": 1.0
    },
    {
      "id": "holding_count",
      "kind": "profile_bound",
      "expression": "profile.holding_count.min <= count(weight_i > 0) <= profile.holding_count.max"
    },
    {
      "id": "single_fund_weight_cap",
      "kind": "profile_upper_bound",
      "expression": "weight_i <= profile.single_fund_weight_upper_bound"
    },
    {
      "id": "asset_class_weight_bounds",
      "kind": "profile_bounds",
      "expression": "profile.class.min <= sum(weight_i for i in class) <= profile.class.max"
    },
    {
      "id": "r5_weight_cap",
      "kind": "profile_upper_bound",
      "expression": "sum(weight_i for risk_level_i = R5) <= profile.r5_weight_upper_bound"
    },
    {
      "id": "manager_concentration_cap",
      "kind": "upper_bound",
      "expression": "sum(weight_i for manager_i = manager) <= 0.25",
      "value": 0.25
    },
    {
      "id": "secondary_type_concentration_cap",
      "kind": "upper_bound",
      "expression": "sum(weight_i for secondary_type_i = secondary_type) <= 0.35",
      "value": 0.35
    },
    {
      "id": "high_similarity_group_cap",
      "kind": "upper_bound",
      "expression": "sum(weight_i for i in high_similarity_group) <= 0.40",
      "value": 0.4,
      "group_threshold": 0.85
    }
  ],
