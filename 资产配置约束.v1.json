  "scope": {
    "purpose": "基于真实资产池的收益风险画像、相似性分析、客户模板和配置约束，为后续问题契约与 QUBO 编码提供标准输入。",
    "data_assumption": "当前资产池主要包含基金概况和多周期指标，不包含日频净值序列。",
    "similarity_interpretation": "当前阶段使用收益、波动、回撤和风险调整收益指标形成资产风险收益画像相似性，不将其称为真实净值相关性。",
    "future_extension": "接入日频净值后，可进一步计算真实收益相关性和协方差矩阵。",
    "pipeline_order": [
      "从真实资产池读取基金概况与多周期指标",
      "生成收益、风险和稳定性画像",
      "计算资产风险收益画像相似性",
      "按客户模板生成配置约束",
      "输出不含权重档位编码的 QUBO 前置数据"
    ],
    "unsupported_rules": [
      "申购规则",
      "赎回规则",
      "流动性约束"
    ],
    "intentionally_omitted": [
